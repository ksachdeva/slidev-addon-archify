{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Parallel Context & Tool Assembly",
    "subtitle": "Memory, hybrid retrieval, and sandboxed tools execute concurrently; untrusted tool output is redacted before assembly",
    "output": "agent-turn-fanout.html",
    "viewBox": [1080, 520],
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "animation": "trace"
  },
  "stages": [
    { "label": "Dispatch" },
    { "label": "Fetch" },
    { "label": "Filter" },
    { "label": "Assemble" },
    { "label": "Synthesize" }
  ],
  "nodes": [
    { "id": "orchestrator", "type": "backend", "label": "Orchestrator", "sublabel": "fan-out × 3", "stage": 0, "row": 1, "tag": "turn" },
    { "id": "memory", "type": "database", "label": "Session Memory", "sublabel": "last 12 turns", "stage": 1, "row": 0, "tag": "state" },
    { "id": "retriever", "type": "backend", "label": "Hybrid Retriever", "sublabel": "dense + BM25", "stage": 1, "row": 1, "tag": "RAG" },
    { "id": "sandbox", "type": "security", "label": "Tool Sandbox", "sublabel": "SQL + API call", "stage": 1, "row": 2, "tag": "isolated" },
    { "id": "vectordb", "type": "database", "label": "Vector Store", "sublabel": "top-8 chunks", "stage": 2, "row": 1, "tag": "reranked" },
    { "id": "policy", "type": "security", "label": "Output Policy", "sublabel": "secret redaction", "stage": 2, "row": 2, "tag": "PII guard" },
    { "id": "context", "type": "messagebus", "label": "Context Builder", "sublabel": "18k token budget", "stage": 3, "row": 1, "tag": "packed" },
    { "id": "llm", "type": "cloud", "label": "Reasoning LLM", "sublabel": "grounded stream", "stage": 4, "row": 1, "tag": "answer" }
  ],
  "flows": [
    { "id": "df-orch-mem", "from": "orchestrator", "to": "memory", "label": "session id", "variant": "default", "fromSide": "top", "toSide": "left" },
    { "id": "df-orch-ret", "from": "orchestrator", "to": "retriever", "label": "query vec", "variant": "emphasis", "route": "straight" },
    { "id": "df-orch-tool", "from": "orchestrator", "to": "sandbox", "label": "tool args", "variant": "security", "fromSide": "bottom", "toSide": "left" },
    { "id": "df-mem-ctx", "from": "memory", "to": "context", "label": "turn history", "variant": "dashed", "fromSide": "right", "toSide": "top" },
    { "id": "df-ret-vec", "from": "retriever", "to": "vectordb", "label": "ANN search", "variant": "emphasis", "route": "straight" },
    { "id": "df-vec-ctx", "from": "vectordb", "to": "context", "label": "cited chunks", "variant": "emphasis", "route": "straight" },
    { "id": "df-tool-pol", "from": "sandbox", "to": "policy", "label": "raw output", "variant": "security", "route": "straight" },
    { "id": "df-pol-ctx", "from": "policy", "to": "context", "label": "sanitized JSON", "variant": "security", "fromSide": "right", "toSide": "bottom" },
    { "id": "df-ctx-llm", "from": "context", "to": "llm", "label": "grounded prompt", "variant": "emphasis", "route": "straight" }
  ]
}
